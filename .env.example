# このファイルを見本に .env ファイルを作成してください
# cp .env.example .env

# PostgreSQL接続文字列 (Supabase: Settings → Database → Connect → Transaction pooler)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-x-xx-xxxx-x.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# PostgreSQL直接接続 (マイグレーション用, Supabase: Settings → Database → Connect → Direct connection)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-x-xx-xxxx-x.pooler.supabase.com:5432/postgres"

# NextAuthのシークレットキー (openssl rand -base64 32 などで生成)
NEXTAUTH_SECRET="your-secret-key-here"

# アプリのURL (本番環境では実際のURLに変更)
NEXTAUTH_URL="http://localhost:3000"

# Upstash Redis (レートリミット用, upstash.com → Database → REST API)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
